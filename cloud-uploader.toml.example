# ====================
# 基础配置
# ====================

debug = false
server_location = "Production Server"
# custom_date = "2026-06-11"
upload_mode = "archive" # "archive", "files", or "hybrid"

# ====================
# Archive 模式
# ====================

[archive]
source_folder = "data/{date}/"
# Pure Rust .tar.zst works out of the box; .7z uses hardened 7z CLI.
output = "archive/{date}.tar.zst"
password = ""
require_archive = true
# level = 6
# dict_size = "32m"
# threads = 4
upload_path = "/apps/archive/{server_location}/{date}/"

# ====================
# Files 模式
# ====================

[files]
source_folder = "data/{date}/"
pattern = "*.csv"
upload_path = "/apps/files/{server_location}/{date}/"

# ====================
# 云盘配置
# ====================

[uploader]
max_concurrent_chunks = 4

[uploader.baidu]
enabled = false
app_key = ""
app_secret = ""
config_path = ""
archive_upload_path = ""
files_upload_path = ""

[uploader.cloud189]
enabled = false
config_path = ""
username = ""
password = ""
use_qr = false
archive_upload_path = ""
files_upload_path = ""

# ====================
# 通知配置
# ====================

[notifier.chanify]
enabled = false
url = "https://chanify.example.com/v1/sender/"
token = ""

[notifier.email]
enabled = false
sender = ""
password = ""
recipient = ""
# smtp_host = "smtp.qq.com"
# smtp_port = 465

[notifier.pushgo]
enabled = false
url = "https://pushgo.example.com/message"
api_token = ""
channel_id = ""
password = ""
hex_key = ""
icon = ""
image = ""
